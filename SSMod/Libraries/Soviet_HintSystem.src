     begin
     HintSpec('RocketLauncher-hint', 3);
     SaveVariable(1, 'HintRocketLauncher');
     end;

     if LoadVariable('HintFlameThrower', 0) and FilterAllUnits([[f_side, 3], [f_or, [f_weapon, 91], [f_weapon, 26], [f_bweapon, 91], [f_bweapon, 26]]]) then
     begin
     HintSpec('FlameThrower-hint', 3);
     SaveVariable(1, 'HintFlameThrower');
     end;

     if LoadVariable('HintLaser', 0) and FilterAllUnits([[f_side, 3], [f_or, [f_weapon, 9], [f_weapon, 10], [f_weapon, 105], [f_bweapon, 9], [f_bweapon, 10], [f_bweapon, 105]]]) then
     begin
     HintSpec('Laser-hint', 3);
     SaveVariable(1, 'HintLaser');
     end;

     if LoadVariable('HintRocket', 0) and FilterAllUnits([[f_side, 3], [f_or, [f_weapon, 47], [f_bweapon, 47]]]) then
     begin
     HintSpec('Rocket-hint', 3);
     SaveVariable(1, 'HintRocket');
     end;

     if LoadVariable('HintBalista', 0) and FilterAllUnits([[f_side, 3], [f_or, [f_weapon, 22], [f_bweapon, 22]]]) then
     begin
     HintSpec('Balista-hint', 3);
     SaveVariable(1, 'HintBalista');
     end;

     if LoadVariable('HintMineSweeper', 0) and FilterAllUnits([[f_side, 3], [f_weapon, 94]]) then
     begin
     HintSpec('MineSweeper-hint', 3);
