Every 0$1 trigger LoadVariable('HintyON', 0) do
begin
     enable;
     if not LoadVariable('HintMG', 0) and FilterAllUnits([[f_side, 3], [f_or, [f_weapon, 42], [f_weapon, 24], [f_weapon, 2], [f_bweapon, 42], [f_bweapon, 24], [f_bweapon, 2]]]) then
     begin
     HintSpec('MachineGun-hint', 3);
     SaveVariable(1, 'HintMG');
     end;

     if not LoadVariable('HintLightGun', 0) and FilterAllUnits([[f_side, 3], [f_or, [f_weapon, 23], [f_weapon, 3], [f_bweapon, 23], [f_bweapon, 3]]]) then
     begin
     HintSpec('LightGun-hint', 3);
     SaveVariable(1, 'HintLightGun');
     end;

     if not LoadVariable('HintGatling', 0) and FilterAllUnits([[f_side, 3], [f_or, [f_weapon, 43], [f_weapon, 25], [f_weapon, 4], [f_bweapon, 43], [f_bweapon, 25], [f_bweapon, 4]]]) then
     begin
