Every 0$1 Trigger MissionStarted do
var engs, i;
begin
     enable;
     engs := FilterAllUnits([[f_side, 2], [f_type, unit_human]]) {diff [Mietek, Smirnovsky, Kostyliev, Tatiana]};

    // ComEnterUnit(engs, testdepot);
     //AddComChangeProfession(engs, 2);
     //AddComExitBuilding(engs);

     if GetClass(engs) = 2 and FilterAllUnits([[f_side, 2], [f_class, 2]]) >= 6 then
     begin
     for i in engs do
           AddComBuild(i, Side6Buildings[1][1], Side6Buildings[1][2], Side6Buildings[1][3], Side6Buildings[1][4]);
           wait(0$1);

{     until IsIdle(i) and Wait(0$10);
     end;
     
     if IsIdle(i) and Wait(0$10) then
     begin
     ComEnterUnit(engs, FilterAllUnits([[f_side, 2], [f_btype, b_armoury]]));
     AddComChangeProfession(engs, 1);
     AddComExitBuilding(engs);
     repeat
     AddComEnterUnit(engs, FilterAllUnits([[f_side, 2], [f_btype, b_bunker], [f_empty]]));
     wait(0$1);
     until
     FilterAllUnits([[f_side, 2], [f_btype, b_bunker], [f_not, [f_empty]]]);  }
                                                                           
     end;                                                                  

end;      