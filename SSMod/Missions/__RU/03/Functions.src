Every 1 trigger IsSelected(Kvantovy) or GetLives(Kvantovy) < 1000 do
begin
KvantovyExp([1,2,3,4]);
Wait(0$05);
Say(Kvantovy,'DKvantovy-Secret-01');
TeleportUnit(Kvantovy,231,232,300,True);
Wait(0$05);
RemoveUnit(Kvantovy);
SaveVariable(1,'SafeKvantovy');
SaveCharacters(Kvantovy,'Kvantovy');
End;

Export Function KvantovyExp(q);
var dec, q1;
begin
  dec = SelectiveQuery('KvantovyQuery', q);
  case dec of
   1:begin
     AddExperience_NoLimit(Yakotich,1,1500);
     end;
   2:begin
     AddExperience_NoLimit(Yakotich,2,1500);
     end;
   3:begin
     AddExperience_NoLimit(Yakotich,3,1500);
     end;
    4:begin
     AddExperience_NoLimit(Yakotich,4,1500);
     end;
  end;
end;

Export Function SibQuery(q);
var dec, q1;
begin
  dec = SelectiveQuery('SibMineQuery', q);
  case dec of
   1:begin
     exit;
     end;
  end;
end;

Every 1 Trigger not BeenInMine and IsInArea(Yakotich, DontGoArea) do
var x, y;
begin

     enable;
     x = GetX(Yakotich);
     y = GetY(Yakotich);

     DialogueOn;

     Say(Yakotich, 'DYak-border');

     DialogueOff;
     InGameOn;

     ComMoveXY(Yakotich, x+2, y+10);
     Wait(0$3);

     InGameOff;


end;

Every 0$1 Trigger CutsceneOn do
begin
     enable;

     SetLives(FilterAllUnits([[f_side, 3], [f_or, [f_type, unit_human], [f_type, unit_vehicle]]]), 1000);

     if not CutsceneOn then
     disable;

end;

Every 0$1 Trigger CutsceneOnDepot do
begin
     enable;

     SetLives(FilterAllUnits([[f_side, 3], [f_or, [f_type, unit_human], [f_type, unit_vehicle]]]), 1000);

     if not CutsceneOnDepot then
     disable;

end;

Export Function GetSiberiteAmount(side);
var i, bases;
begin
result := 0;

bases := FilterAllUnits([[f_side, side], [f_or, [f_btype, b_depot], [f_btype, b_warehouse]]]);

if not bases then
   exit;

for i in bases do
    result := result + GetResourceType(GetBase(i), mat_siberit);
End;

Every 0$01 trigger OvsyenkoRecovered do
var siberite, mine;
begin
enable;

     siberite := GetSiberiteAmount(3);
     mine := FilterUnitsInArea(OvsyenkoArea, [[f_side, 3], [f_btype, b_siberite_mine]]);

     if siberite < 0 then
        siberite := 0;

     display_strings := ['#SibGathered', siberite, SibNeededToWin];

     if siberite >= SibNeededToWin then
     begin
          Say(Mietek,'DMietek-Mine-03');
          display_strings := '';
          SiberiteGathered := True;
          disable;
     end;

End;

Every 0$1 Trigger OvsyenkoRecovered and GetSiberiteAmount(3) >= 25 and FilterAllUnits([[f_side, 3], [f_btype, b_siberite_mine]]) >= 1 do
begin
     DialogueOn;
     Say(Mietek,'DMietek-Mine-01');
     Say(Mietek,'DMietek-Mine-02');
     SibQuery(1);
     CenterOnUnits(FilterAllUnits([[f_side, 3], [f_btype, b_siberite_mine]]));
     DialogueOff;
end;











