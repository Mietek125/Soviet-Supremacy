On Contact(side1, side2) do
begin

     if GetSide(side1) = 3 and GetSide(side2) = 6 then
     begin

     CenterOnUnits(Mietek);
     DialogueOn;
     Say(Mietek, 'DMietek-AllyAttack');
     YouLost('AllyAttack');
     end;

end;

On BuildingComplete(b) do
begin

     if GetSide(b) = 3 and GetBType(b) = b_siberite_power then
        SibPowerComplete := True;

     if GetSide(b) = 6 then
        Side6Buildings := Delete(Side6Buildings, 1);

     if GetSide(b) = 6 and GetBType(b) = b_lab then
        ComEnterUnit([Tatiana,Smirnovsky], b);

     if GetSide(b) = 6 and GetBType(b) = b_workshop then
        ComEnterUnit(Kostyliev, b);

     if GetSide(b) = 6 and GetBType(b) = b_armoury then
        ComEnterUnit(Maxim, b);
end;

On BuildingCaptured(b, bf, cu) do
begin

     if GetBType(b) = b_lab_full and GetSide(bf) = 1 then
     begin
          ChangeMissionObjectives('ObLab2');
          SaveVariable('OptoLabCaptured', 1);
     end;

end;


On VehicleConstructed(veh, f) do
begin

     if GetSide(veh) = 3 and GetWeapon(veh) = ru_rocket_launcher and not FirstRocket then
     begin

     Wait(0$3);

     FirstRocket := True;
     CenterOnUnits(veh);
     DialogueOn;
     Say(Tatiana, 'DTat-04-01');
     Say(Smirnovsky, 'DVlad-04-02');
     Say(Smirnovsky, 'DVlad-04-03');
     Say(Yakotich, 'DYak-04-04');
     DialogueOff;
     RocketLaunchersConstructed := RocketLaunchersConstructed +1 end else
     if GetSide(veh) = 3 and GetWeapon(veh) = ru_rocket_launcher and FirstRocket then
     RocketLaunchersConstructed := RocketLaunchersConstructed +1;

     if GetSide(veh) = 3 and GetEngine(veh) = engine_siberite then
     SibEngineConstructed := True;

end;


Every 0$1 Trigger RocketLaunchersConstructed >= 3 do
ChangeMissionObjectives('ObRocket');

Every 0$1 Trigger SibPowerComplete and SibEngineConstructed do
ChangeMissionObjectives('ObSibTech');

On UnitDestroyed(un) do
begin

     if un = Ovsyenko and GetSide(un) = 3 and OvsyenkoRecovered then
     begin

          Wait(0$2);

          CenterOnXY(125,120);
          DialogueOn;
          Say(Mietek, 'DMietek-Ovsyenko-01');
          Say(Yakotich, 'DYak-Ovsyenko-02');

           OvsyenkoDestroyed := True;
           SetRestrict(b_depot, 3, True);

     end;

     if un = Yakotich then
     YouLost('YakDead');

     if un = Mietek then
     YouLost('MietekDead');

     if un in FilterAllUnits([[f_side, 3], [f_not, [f_nation, 0]], [f_type, unit_human]]) diff [Yakotich, Mietek, YakotichTeam, DimitriTeam] then
     Begin
     YouLost('TeamDead');
     end;

     if un = Ovsyenko and not OvsyenkoRecovered then
     YouLost('OvsyenkoDead');

     if un = Voroshilov then
     YouLost('DepotDead');

end;

Every 0$1 Trigger GetLives(FilterAllUnits([f_control, control_remote])) < 250 do
Begin

     CenterOnUnits([[[f_not, [f_ok]], [f_control, control_remote]]]);
     Say(Mietek, 'DMietek-Remote-01');
     Say(Yakotich, 'DMietek-Remote-02');

end;

Every 0$1 Trigger See(3, usLab) do
begin

     DialogueOn;
     Say(Yakotich, 'DYak-Lab-01');
     ChangeMissionObjectives('ObLab');
     DialogueOff;

end;

Every 0$1 Trigger See(3, usCt) do
begin

     DialogueOn;
     Say(Mietek, 'DMietek-Remote-03');
     Say(Yakotich, 'DYak-Remote-04');
     DialogueOff;

end;


