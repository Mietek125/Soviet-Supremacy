Starting
begin
     ResetFog;
     Init;

     AnimateTrees(true);
     ComHold(Kvantovy);
     PlaceEnvironment(194, 224, 54, 1);

     InitRussian;
     InitAmericans;
     InitAction;

     DebugMode; 
end;

