Export Function InitAction;
Begin

     InGameOn;
     Wait(0$3);

     Say(Yakotich, 'DYak-01-01');
     Say(Yakotich, 'DYak-01-02');
     Say(Mietek, 'DMietek-01-03');
     Say(Maxim, 'DMax-01-04');
     Say(Yakotich, 'DYak-01-05');


     ComMoveXY([Dragunov, Tatiana, Smirnovsky, Kostyliev, Maxim], 72, 48);
     AddComMoveXY(Tatiana, 87, 114);
     AddComMoveXY(Smirnovsky, 82, 110);
     AddComMoveXY(Kostyliev, 79, 106);
     ComMoveXY(YakotichTeam, 72, 48);
     ComMoveXY(Yakotich, 86, 59);
     AddComTurnUnit(Yakotich, IvanBerezov);
     ComMoveXY(Mietek, 84, 57);
     AddComTurnUnit(Mietek, IvanBerezov);

     CenterOnXY(72, 47);

     ChangeSideFog(9,3);
     ChangeSideFog(6,3);
     ChangeSideFog(4,3);
     ChangeSideFog(7,3);
end;

Every 0$1 Trigger GetX(Yakotich) = 86 and GetY(Yakotich) = 59 do
begin

     CenterOnUnits(Yakotich);

     SayNoName(IvanBerezov, 'DBer-01-05');
     Say(Yakotich, 'DYak-01-06');

     ChangeSideFog(9,3);
     ChangeSideFog(6,3);
     ChangeSideFog(4,3);

     Say(IvanBerezov, 'DBer-01-07');
     Say(IvanBerezov, 'DBer-01-08');
     Say(Yakotich, 'DYak-01-09');
     Say(IvanBerezov, 'DBer-01-10');
     Say(Yakotich, 'DYak-01-11');
     Say(IvanBerezov, 'DBer-01-12');
     Say(Yakotich, 'DYak-01-13');
     Say(IvanBerezov, 'DBer-01-14');
     Say(Yakotich, 'DYak-01-15');
     Say(IvanBerezov, 'DBer-01-16');

     AddComMoveXY(Dragunov, 80, 106);
     ComMoveXY(YakotichTeam, 79, 96);
     ComMoveXY(Yakotich, 68, 99);
     AddComTurnUnit(Yakotich, Platonov);
     ComMoveXY(Mietek, 72, 104);
     AddComTurnUnit(Mietek, Platonov);

     CenterOnXY(70, 100);

end;

Every 0$1 Trigger GetX(Yakotich) = 68 and GetY(Yakotich) = 99 and GetX(Smirnovsky) = 82 and GetY(Smirnovsky) = 110 and GetX(Tatiana) = 87 and GetY(Tatiana) = 114 do
begin
                                                                               
     CenterOnUnits(Yakotich);

     ComMoveXY(YakotichTeam, 86, 106);

     SetSide([Smirnovsky, Tatiana, Cargo1, Cargo2], 6);
     Wait(0$1);
     AddComExitVehicle(Tatiana);
     AddComExitVehicle(Smirnovsky);
     Wait(0$1);
     AddComEnterUnit([Smirnovsky, Tatiana], labhg);

     Say(Yakotich,'DYak-01-17');
     Say(Morozov,'DMor-01-18');
     Say(Morozov,'DMor-01-19');
     Say(Yakotich,'Dyak-01-20');
     Say(Morozov,'DMor-01-21');
     Say(Morozov,'DMor-01-22');

     ComEnterUnit(Morozov,MorozovBase);

     Say(Platonov,'DPlat-01-23');
     Say(Yakotich,'DYak-01-24');
     Say(Platonov,'DPlat-01-25');
     Say(Popov,'DPop-01-26');
     Say(Yakotich,'DYak-01-27');
     Say(Popov,'DPop-01-28');
     Say(Popov,'DPop-01-29');

     InitFirstAttack;

     CenterOnUnits(Gaydar);

     SayRadioNoName(Gaydar,'DGay-01-30');
     Say(Platonov,'DPlat-01-31');

     CenterOnUnits(Yakotich);

     Say(Platonov,'DPlat-01-32');
     Say(Yakotich,'DYak-01-33');

     ComEnterUnit([Platonov, Popov], MorozovBase);

     AddComExitBuilding([Smirnovsky,Tatiana]);
     SetSide([Smirnovsky,Tatiana, Cargo1, Cargo2], 3);
     AddComEnterUnit(Smirnovsky, Cargo1);
     AddComEnterUnit(Tatiana, Cargo2);
     AddComMoveToArea(Smirnovsky, LeninCratesSend);
     AddComExitVehicle(Smirnovsky);
     ComMoveXY(Kovalyuk, 99, 166);
     AddComMoveXY(YakotichTeam, 106, 108);
     AddComMoveXY(YakotichTeam, 159, 233);
     AddComMoveXY([Kostyliev, Maxim, Cargo2, Smirnovsky, Tatiana], 159,233);
     AddComMoveXY(Mietek, 170, 238);
     AddComTurnUnit(Mietek, Natasha);

     AddComMoveXY(Yakotich, 102, 155);
     AddComMoveXY(Dragunov, 100, 157);

     CenterOnXY(102, 152);

end;

Every 0$5 Trigger IsInArea(Cargo1, LeninCratesSend) do
begin
    ComEnterUnit(Kovalyuk, Cargo1);
end;

Every 0$1 Trigger GetX(Yakotich) = 102 and GetY(Yakotich) = 155 do
begin

     ComExitBuilding(Scholtze);
     AddComTurnUnit(Scholtze, Yakotich);
     AddComTurnUnit([Dragunov, Yakotich], Scholtze);

     Say(Scholtze, 'DSch-01-34');
     Say(Scholtze, 'DSch-01-35');
     Say(Yakotich, 'DYak-01-36');
     Say(Scholtze, 'DSch-01-37');

     SetSide(Dragunov, 6);
     ComEnterUnit([Scholtze,Dragunov], lab2);

     AddComMoveXY(Yakotich, 168, 237);
     AddComTurnUnit(Yakotich, Natasha);

     CenterOnUnits(Natasha);

end;

Every 0$1 Trigger GetX(Yakotich) = 168 and GetY(Yakotich) = 237 and not StartEnded do
begin

     Say(Yakotich, 'DYak-01-38');
     Say(Natasha, 'DNat-01-39');
     Say(Mietek, 'DMietek-01-40');
     Say(Mietek, 'DMietek-01-41');
     Say(Natasha, 'DNat-01-42');
     Say(Yakotich, 'DYak-01-43');

     ChangeMissionObjectives('Ob1');
     InGameOff;
     RevealFogArea(3, RevealStartArea);

     StartEnded := True;

     Say(Smirnovsky,'DVlad-02-01');
     Say(Tatiana,'DTat-02-02');
     Say(Yakotich,'DYak-02-03');

     ChangeMissionObjectives('Ob2');

end;

Every 0$1 Trigger FilterAllUnits([[f_side, 4], [f_type, unit_vehicle], [f_weapon, ru_big_cargo_bay]]) do
begin

     Wait(0$3);
     DialogueOn;
     InGameOn;
     CenterOnUnits(Bukov);

     SayRadioNoName(Bukov, 'DBukov-03-01');
     SayRadio(Platonov, 'DPlat-03-02');
     Say(Yakotich, 'DYak-03-03');
     SayRadio(Platonov, 'DPlat-03-04');
     Say(Mietek,'DMietek-03-05');
     Say(Mietek,'DMietek-03-06');
     Say(Yakotich,'DYak-03-07');
     Say(Yakotich,'DYak-03-08');
     Say(Maxim,'DMax-03-09');
     Say(Mietek,'DMietek-03-10');

     if Difficulty = 1 then
        ChangeMissionObjectives('Ob3a') else
     if Difficulty = 2 then
        ChangeMissionObjectives('Ob3b') else
     if Difficulty = 3 then
        ChangeMissionObjectives('Ob3c');

     if LoadVariable('HintyON', 1) then
        AdditionalQuestsQuery(1);

     ChangeMissionObjectives('Ob3');
     BukovConvoysActive := True;

     ComMoveXY([Kovalyuk, Balei], 99, 165);
     SetAreaMapShow(LeninCratesSend, 1);

     DialogueOff;
     InGameOff;

end;

Every 0$1 Trigger StartEnded and GameTime > 25$0 and FilterUnitsInArea(BerezovBaseArea,[f_side, 3]) do
var ru;
begin
     InGameOn;
     ru := FilterUnitsInArea(BerezovBaseArea,[f_side, 3]);
     ComMoveXY(ru, 123, 107);
     repeat;
     Wait(0$1);
     until
     IsInArea(BerezovBaseArea, ru);
end;

Every 0$1 Trigger GameTime > 25$0 and not FilterUnitsInArea(BerezovBaseArea,[f_side, 3]) do
var gatlingsold;
begin

     InGameOn;
     CenterOnUnits(IvanBerezov);

     InitBergkampAttack;

     SayRadio(IvanBerezov, 'DBer-04-01');

     gatlingsold := UnitsInside(gatlingbunk);

     ComExitBuilding(gatlingsold);
     ComMoveXY(gatlingsold, 72, 102);


     SayRadio(Platonov, 'DPlat-04-02');
     SayRadio(IvanBerezov, 'DBer-04-03');

     ComExitBuilding(BerezovTeam);
     AddComMoveXY(BerezovTeam, 72, 102);
     ComEnterUnit(IvanBerezov,BerezovTank);
     AddComMoveXY(IvanBerezov, 79, 109);
     AddComMoveXY(IvanBerezov, 79, 114);
     AddComExitVehicle(IvanBerezov);
     AddComMoveXY(IvanBerezov, 68, 95);
     AddComTurnXY(IvanBerezov, 68,98);

     SayRadio(Platonov, 'DPlat-04-04');

     Wait(0$25);

     SetSide(FilterAllUnits([[f_side, 7], [f_type, unit_building]]) diff [BerezovA1, BerezovA2, BerezovA3], 8);

     CenterOnUnits(Yakotich);

     Say(Platonov, 'DPlat-04-05');   
     Say(Platonov, 'DPlat-04-06');
     Say(Yakotich, 'DYak-04-07');
     Say(Yakotich, 'DYak-04-08');
     Say(Mietek, 'DMietek-04-09');
     Say(Kostyliev, 'DBog-04-10');

     ChangeMissionObjectives('Ob4');

     InGameOff;

     BerezovEscaped := True;

     ComEnterUnit(BerezovTeam, BerezovA1);
     Wait(0$30);
     ComEnterUnit(BerezovTeam, BerezovA2);
     Wait(0$10);
     ComEnterUnit(BerezovTeam, BerezovA3);

end;

Every 0$1 Trigger GetSide(BerezovBase) = 3 and IsDead(BerezovLab) do
var BergkampSurvivors;
begin

     InGameOn;

     BergkampSurvivors := FilterAllUnits([[f_side, 8], [f_type, unit_human]]);
     ComExitBuilding(BergkampSurvivors);
     ComMoveToArea(BergkampSurvivors, BergkampEscapeArea);
     CenterOnUnits(BerezovBase);

     Say(Mietek, 'DMietek-05-05');
     Say(Maxim, 'DMax-05-06');
     Say(Kostyliev, 'DBog-05-07');
     Say(Yakotich, 'DYak-05-08');
     Say(Yakotich, 'DYak-05-09');
     Say(Platonov, 'DPlat-05-10');

     ChangeMissionObjectives('Ob4Out');

     InGameOff;

end;

Every 0$1 Trigger GameTime > 28$0 do
var BukovCivilians, tmp, i;
begin

     DialogueOn;
     InGameOn;

     SayRadioNoFace(Pompa, 'DPompa-06-01');
     SayRadio(Platonov, 'Dplat-06-02');
     SayRadioNoFace(Pompa, 'DPompa-06-03');
     SayRadioNoFace(Pompa, 'DPompa-06-04');
     SayRadio(Platonov, 'DPlat-06-05');
     SayRadio(Bukov, 'DBukov-06-06');

     DialogueOff;
     InGameOff;

     BukovCivilians := FilterAllUnits([[f_side, 4], [f_type, unit_human], [f_not, [f_class, class_soldier]]]);
     ComExitBuilding(BukovCivilians);
     AddComMoveXY(BukovCivilians,70,101);
     ComEnterUnit(Bukov, BukovTank);
     AddComMoveXY(Bukov, 82, 108);
     AddComMoveXY(Bukov, 82, 114);
     AddComExitVehicle(Bukov);

     SetSide([Bukov, BukovCivilians], 6);
     ComEnterUnit(Bukov, MorozovBase);

     for i in BukovCivilians do
     begin
          case GetClass(i) of
          class_scientistic: tmp := FilterUnitsInArea(NorthLeninArea,[[f_side, 6], [f_not, [f_full]], [f_btype, b_lab_full]]);
          class_mechanic: tmp := FilterUnitsInArea(NorthLeninArea,[[f_side, 6], [f_not, [f_full]], [f_btype, b_factory]]);
     end;

     if tmp[1] then
          ComEnterUnit(i, tmp[1]);
     end;
end;

Every 0$1 Trigger GameTime > 29$0 do
begin

     PlaceUnitArea([Pompa, Radenko, Petrov, Konajev, Mielnik], PompaSpawn, False);
     ComEnterUnit([Pompa, Petrov, Konajev, Mielnik], PompaArmor);
     ComMoveToArea(Radenko, RadenkoEscape);

end;

Every 0$1 Trigger IsInArea(Radenko, RadenkoEscape) do
RemoveUnit(Radenko);

Every 0$1 Trigger GameTime > 31$0 do
begin


end;










