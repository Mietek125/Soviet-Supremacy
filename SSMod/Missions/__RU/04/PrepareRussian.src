Export Function InitRussian;
var i, tmp, SouthB, NorthB, un;
begin

      //FLAGI DLA POJAZDOW
      SetMark(BukovTank, -4);
      SetMark(GaydarTank, -6);
      SetMark(BerezovTank, -7);

    {===== NASI (CZERWONI) =====}

     Uc_Side := 3;
     Uc_Nation := 3;

     Yakotich := PrepareUnit('Yakotich', (not debug), prevMissionPrefix);
     Mietek := PrepareUnit('Mietek', (not debug), prevMissionPrefix);
     Maxim := PrepareUnit('Maxim', (not debug), prevMissionPrefix);
     Smirnovsky := PrepareUnit('Smirnovsky', (not debug), prevMissionPrefix);
     Kostyliev := PrepareUnit('Kostyliev', (not debug), prevMissionPrefix);
     Tatiana := PrepareUnit('Tatiana', (not debug), PrevMissionPrefix);
     Dragunov := PrepareUnit('Dragunov', (not debug), PrevMissionPrefix);

     YakotichTeam := CreateCharacterSet(PrevMissionPrefix & 'YakotichTeam');

     SetClass([Smirnovsky, Tatiana, Dragunov],  4);
     SetCLass(Kostyliev, 3);
     SetClass([Mietek, Yakotich, Maxim], 1);


     PrepareVehicle(Ru_Heavy_Tracked, engine_siberite, control_manual, Ru_Big_Cargo_Bay, 100);
     PrepareVehicle(Ru_Heavy_Tracked, engine_siberite, control_manual, Ru_Big_Cargo_Bay, 100);
     Cargo1 := CreateVehicle;
     Cargo2 := CreateVehicle;
     SetCargo([Cargo1, Cargo2], mat_siberit, 200);


     PrepareVehicle(Ru_Medium_Tracked, engine_siberite, control_manual, Ru_Rocket_Launcher, 100);
     Tank := CreateVehicle;

     OurGuys := OurGuys ^ YakotichTeam ^ Yakotich ^ Mietek ^ Dragunov ^ Maxim;

     for i in OurGuys do
     PlaceUnitArea(i, SpawnArea, False);
     PlaceUnitXY(Cargo1, 18, 6, False);
     PlaceUnitXY(Cargo2, 15, 5, False);
     PlaceUnitXY(Tank, 11, 5, False);

     PlaceHumanInUnit(Smirnovsky, Cargo1);
     PlaceHumanInUnit(Tatiana, Cargo2);
     PlaceHumanInUnit(Kostyliev, Tank);

     Natasha := NewCharacter('Natasha');

     OtherTeam := CreateCharacterSet('02_OtherTeam');

     for i in OtherTeam do
     PlaceUnitXYR(i,157,232,3,False);

     PlaceUnitXY(Natasha,171,243,False);
     ComTurnUnit(Natasha, Yakotich);      

     {===== EKIPA BUKOWA (jasnoniebiescy) =====}

     Uc_Side := 4;

     Bukov := NewCharacter('Bukov');

     PrepareBase(4, 3, BukovBaseArea, 4, 3, 2, 10, 2);

     ComEnterUnit(FilterAllUnits([[f_side, 4], [f_class, 2]]), BukovBase);

     PlaceUnitXY(Bukov,328,235,False);
     AddComTurnXY(Bukov,324,231);

     {===== EKIPA BIERIEZOWA (zieloni) =====}

     Uc_Side := 7;

     //IvanBerezov := PrepareUnit('IvanBerezov', (not debug), '');
     IvanBerezov := NewCharacter('IvanBerezov');
     Korotajev := NewCharacter('Korotajev');
     Lesov := NewCharacter('Lesov');
     Bautin := NewCharacter('Bautin');
     Sharonova := NewCharacter('Sharonova');

     Hc_Name := 'Boris Aleinik';
     Hc_Gallery := 'AbsoluteDominion';
     Hc_Face_Number := 15;
     Hc_Skills := [6,2,2,3];
     Hc_Class := 1;
     Hc_Sex := 1;
     Aleinik := CreateHuman;

     Hc_Name := 'Yuri Pochinchuk';
     Hc_Face_Number := 13;
     Hc_Skills := [5,2,5,2];
     Pochinchuk := CreateHuman;

     Hc_Name := 'Ilya Yembachtov';
     Hc_Face_Number := 7;
     Hc_Skills := [5,2,5,3];
     Yembachtov := CreateHuman;

     Hc_Name := 'Jim Azarian';
     Hc_Face_Number := 9;
     Hc_Skills := [5,3,3,3];
     Azarian := CreateHuman;

     Hc_Name := 'Igor Ozerov';
     Hc_Face_Number := 6;
     Hc_Skills := [5,5,3,4];
     Ozerov := CreateHuman;

     Hc_Name := 'Nina Fomchenko';
     Hc_Face_Number := 11;
     Hc_Skills := [5,3,2,3];
     Hc_Sex := 2;
     Fomchenko := CreateHuman;

     Hc_Name := 'Petr Subkov';
     Hc_Face_Number := 12;
     Hc_Skills := [4,4,5,3];
     Hc_Sex := 1;
     Hc_Class := 3;
     Subkov := CreateHuman;

     Hc_Name := 'Petr Umanets';
     Hc_Face_Number := 8;
     Hc_Skills := [2,3,6,2];
     Umanets := CreateHuman;

     Hc_Name := 'Yuri Zakharov';
     Hc_Face_Number := 14;
     Hc_Skills := [3,3,2,3];
     Hc_Class := 2;
     Zakharov := CreateHuman;

     Hc_Name := 'Filip Kulikov';
     Hc_Face_Number := 10;
     Hc_Skills := [3,5,3,2];
     Kulikov := CreateHuman;

     BerezovTeam := BerezovTeam ^ Lesov ^ Korotajev ^ Bautin ^ Sharonova ^ Kulikov ^ Azarian ^ Yembachtov ^ Ozerov ^ Fomchenko ^ Pochinchuk ^ Subkov ^ Umanets ^ Zakharov ^ Aleinik;

     PlaceUnitXY(IvanBerezov,87,58,False);
     AddComTurnUnit(IvanBerezov, Yakotich);

     for i in BerezovTeam do
     begin
          case GetClass(i) of
          class_soldier: tmp := FilterAllUnits([[f_side, 9], [f_not, [f_full]], [f_btype, b_breastwork]]) ^ FilterAllUnits([[f_side, 9], [f_not, [f_full]], [f_btype, b_bunker]]) ^ FilterUnitsInArea(BerezovBaseArea, [[f_side, 9], [f_not, [f_full]], [f_or, [f_btype, b_armoury], [f_btype, b_barracks]]]);
          class_scientistic: tmp := FilterAllUnits([[f_side, 9], [f_not, [f_full]], [f_btype, b_lab_full]]);
          class_mechanic: tmp := FilterAllUnits([[f_side, 9], [f_not, [f_full]], [f_btype, b_factory]]);
          class_engineer: tmp := FilterAllUnits([[f_side, 9], [f_not, [f_full]], [f_btype, b_depot]]);
     end;

     if tmp then
     begin
          if GetBType(tmp[1]) in [b_breastwork] then
             PlaceUnitInBunker(i, tmp[1])
          else
               PlaceHumanInUnit(i, tmp[1])
     end
          else
          PlaceUnitXYR(i, 93, 53, 3, false)
     end;

     {===== EKIPA WSZYSTKICH INNYCH (ró¿owi) =====}

     Uc_Side := 9;

     Pompa := NewCharacter('Pompa');
     Mielnik := NewCharacter('Mielnik');
     Petrov := NewCharacter('Petrov');
     Konajev := NewCharacter('Konajev');
     Radenko := NewCharacter('Radenko');



     {===== EKIPA WSZYSTKICH INNYCH (ró¿owi) =====}

     Uc_Side := 6;
     Hc_Sex := rand(1,2);
     Hc_Gallery := '';
     Hc_Face_Number := 0;
     Hc_Skills := [];
     Hc_Name := '';
     Hc_Class := 1;

     PrepareSolBun(4,SouthB1);
     PrepareSolBun(4,SouthB2);
     PrepareSolBun(4,SouthB3);

     PrepareSolBun(4,NorthB1);
     PrepareSolBun(4,NorthB2);
     PrepareSolBun(4,NorthB3);
     PrepareSolBun(4,NorthB4);

     PrepareBase(6, 3, NorthCheckpointArea, 4, 0, 0, 4, 2);
     Gaydar := NewCharacter('Gaydar');
     PlaceUnitXY(Gaydar,190,161,False);
     ComTurnXY(Gaydar,209,163);

     PrepareBase(6, 3, SouthCheckpointArea, 4, 0, 0, 4, 2);

     Furmanov := NewCharacter('Furmanov');
     Kozlov := NewCharacter('Kozlov');
     Oblukov := NewCharacter('Oblukov');
     Kapitsova := NewCharacter('Kapitsova');

     Kovalyuk := NewCharacter('Kovalyuk');
     Scholtze := NewCharacter('Scholtze');
     Balei := NewCharacter('Balei');
     Jaunzeme := NewCharacter('Jaunzeme');
     Benko := NewCharacter('Benko');
     Kuklajs := NewCharacter('Kuklajs');
     Saseda := NewCharacter('Saseda');
     Jaworska := NewCharacter('Jaworska');
     Kuzmov := NewCharacter('Kuzmov');
     Gnyevko := NewCharacter('Gnyevko');

     SetClass(Kovalyuk, 2);

     SouthLeninTeam := SouthLeninTeam ^ Scholtze ^ Furmanov ^ Kozlov ^ Oblukov ^ Kapitsova ^ Balei ^ Jaunzeme ^ Benko ^ Kuklajs ^ Kovalyuk ^ Saseda ^ Jaworska ^ Gnyevko ^ Kuzmov;

     for i in SouthLeninTeam do
     begin
          case GetClass(i) of
          class_soldier: tmp := FilterUnitsInArea(SouthLeninArea, [[f_side, 6], [f_not, [f_full]], [f_btype, b_bunker]]) ^ FilterUnitsInArea(SouthLeninArea, [[f_side, 6], [f_not, [f_full]], [f_btype, b_barracks]]);
          class_scientistic: tmp := FilterUnitsInArea(SouthLeninArea,[[f_side, 6], [f_not, [f_full]], [f_btype, b_lab_half]]);
          class_mechanic: tmp := FilterUnitsInArea(SouthLeninArea,[[f_side, 6], [f_not, [f_full]], [f_btype, b_factory]]);
          class_engineer: tmp := FilterUnitsInArea(SouthLeninArea,[[f_side, 6], [f_not, [f_full]], [f_btype, b_depot]]);
     end;

     if tmp then
     begin
          if GetBType(tmp[1]) in [b_breastwork] then
             PlaceUnitInBunker(i, tmp[1])
          else
               PlaceHumanInUnit(i, tmp[1])
     end
          else
          PlaceUnitXYR(i, 105, 165, 3, false)
     end;

     PrepareBase(6, 3, NorthLeninArea, 5, 3, 3, 3, 3);

     Morozov := NewCharacter('Morozov');
     Platonov := NewCharacter('Platonov');
     Popov := NewCharacter('Popov');

     PlaceUnitXY(Morozov,64,98,False);
     PlaceUnitXY(Platonov,64,97,False);
     PlaceUnitXY(Popov,65,100,False);
     ComTurnUnit([Morozov,Platonov,Popov],Yakotich);

     SetSide(FilterAllUnits([f_side, 9]) diff PompaArmor, 7);
     SetBLevel(FilterAllUnits([[f_side, 7], [f_type, unit_building]]), 10);
     SetBLevel(FilterAllUnits([[f_side, 6], [f_type, unit_building]]), 10);
     SetBLevel(FilterAllUnits([[f_side, 3], [f_type, unit_building]]), 10);

end;

Export Function InitYashin;
var veh1, veh2;
Begin

     Yashin := NewCharacter('Yashin');
     Sevi := NewCharacter('Vsevolod');


     PrepareVehicle(ru_medium_wheeled, engine_siberite, control_manual, ru_rocket_launcher, 100);
     veh1 := CreateVehicle;
     PrepareVehicle(ru_medium_wheeled, engine_siberite, control_manual, ru_gun, 100);
     veh2 := CreateVehicle;

     PlaceUnitArea([veh1,veh2], YashinSpawn, False);
     PlaceHumanInUnit(Yashin, veh1);
     PlaceHumanInUnit(Sevi, veh2);

end;

every 0$1 Trigger StartEnded do
var tmp, i;
Begin

     {===== AI BUKOWA (jasnoniebiescy) =====}

     AddComResearch(BukovLab, Tech_Cargo);
     AddComResearch(BukovLab, Tech_Track);
     ResAllTechs(4, BukovLab, 3);
     ResAllTechs(6, BukovLab, 3);

     repeat
     Wait(0$1)
     until
     Researched(4,83) and Researched(4,84);

     ComConstruct(BukovFactory, ru_heavy_wheeled, engine_combustion, control_manual, ru_big_cargo_bay);
     AddComConstruct(BerezovFac, ru_heavy_tracked, engine_combustion, control_computer, ru_big_cargo_bay);

end;

every 0$1 Trigger StartEnded do
var temp, i, engs;
begin

    {===== AI BIEREZOWA (zieloni) =====}

    enable;
    engs := FilterAllUnits([[f_side, 7], [f_class, class_engineer]]);
    ResAllTechs(7, BerezovLab, 3);
    ComUpgrade(BerezovBase);
    ComUpgrade(BerezovArm);



    for i in engs do
     begin
      if Side7Buildings and not IsIdle(i) then
         ComBuild(i, Side7Buildings[1][1], Side7Buildings[1][2], Side7Buildings[1][3], Side7Buildings[1][4]);

    end;
      if not Side7Buildings and IsIdle(i) then
         ComEnterUnit(engs, BerezovBase);
end;

