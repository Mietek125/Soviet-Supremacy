Starting
var b, n;
begin

ResetFog;
Init;

SetBname(NorthLenin,'lenin');
SetBname(SouthLenin,'lenin');
SetBname(MorozovBase,'OperationCentre');
SetBname(YakotichBase,'Kamenev');
SetBname(BukovBase,'Kuybyshev');
SetBname(BerezovBase,'Zinoviev');

AnimateTrees(true);

Randomize;
RandomizeAll;

for b in FilterUnitsInArea(SouthLeninArea,[[f_type, unit_building]]) do
    ComLinkToBase(SouthLenin, b);

for n in FilterUnitsInArea(NorthLeninArea,[[f_type, unit_building]]) do
    ComLinkToBase(NorthLenin, n);

ComHold(Janusz);
ComHold(Jakes);

InitGlobalVariables;
InitRussian;
InitAction;


end;

Export YakotichTeam, BerezovTeam, PompaTeam, BukovTeam, GaydarTeam, NorthLeninTeam, SouthLeninTeam, CheckpointsTeam, SouthCheckpointTeam, HeikeTeam, OmarTeam, BergkampTeam, SchulzTeam, OtherTeam, OldCrewTeam; //Ekipy
Export Tank, Cargo1, Cargo2;                                  //Tranport z 03
Export Pompa, Mielnik, Petrov, Konajev, Radenko;              //Ekipa Pompy
Export Morozov, Platonov, Popov, Gaydar, Yashin, Bukov, Sevi;                 //Dowódcy Ruskich


Export Oblukov, Kozlov, Furmanov, Scholtze, Kapitsova, Balei, Jaunzeme, Benko, Kuklajs, Kuzmov, Jaworska, Saseda, Kovalyuk, Gnyevko; //Ekipa po³udniowy Lenin (nasi potem)
Export Natasha;                                                                                                   //Nasza
Export Yakotich, Mietek, Kostyliev, Smirnovsky, Maxim, Tatiana, Dragunov;                                         //Nasi Ludzie
Export IvanBerezov, Sharonova, Lesov, Aleinik, Korotajev, Bautin, Zakharov,                                       //Ekipa Bieriezowa
Ozerov, Yembachtov, Umanets, Azarian, Kulikov, Fomchenko, Subkov, Pochinchuk;                                     //Ekipa Bieriezowa

Export Heike, Omar, Schulz, Bergkamp;                         //Dowódcy Arabów

Export RetreatTime, GameTime;

Export CansToTransport, BarrelsToTransport, OurGuys, Side7Buildings;

export Debug; //tests only!

Export PrevMissionPrefix, MissionPrefix;
Export StartEnded, BerezovEscaped, BukovEscaped, GaydarEscaped,
BukovConvoysActive, CratesGathered, YakotichEscaped, SeenComputer,
OilGathered, CratesGatheredExtra, OilGatheredExtra;


Function Init;
begin

SetAttitude(9,3,1,True);
SetAttitude(9,4,1,True);
SetAttitude(9,6,1,True);

CansToTransport := [2500, 3000, 3500][Difficulty];
BarrelsToTransport := [3500, 4000, 5000][Difficulty];

PrevMissionPrefix := '03_';
MissionPrefix := '04_';
//Debug := True;

StartEnded := False;
BerezovEscaped := False;
GaydarEscaped := False;
BukovEscaped := False;
YakotichEscaped := False;
BukovConvoysActive := False;
CratesGathered := False;
OilGathered := False;
CratesGatheredExtra := False;
OilGathered := False;
SeenComputer := False;

Side7Buildings := [[b_ext_rocket, 87, 40, 4],
                  [b_turret, 78, 38, 2],
                  [b_turret, 104, 64, 5],
                  [b_turret, 99, 59, 5],
                  [b_turret, 76, 61, 0],
                  [b_turret, 70, 56, 0],
                  [b_turret, 84, 35, 3],
                  [b_turret, 108, 63, 5],
                  [b_turret, 87, 30, 2]];

GameTime := 0$0;
RetreatTime := 30$0;

end;


