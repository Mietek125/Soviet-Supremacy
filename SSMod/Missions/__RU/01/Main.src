Export Function Init;
Begin

SetBName(RuDepot, 'OutpostG1');

MissionPrefix := '01_';
//Debug := True;
CaveCheck := False;
HillCheck := False;
RoadCheck := False;
WasInBase := False;
Vehicle_Constructed := False;
All_Techs_Done := False;
Recon_Done := False;
Maxim_Coming := False;
Stefan_Rescued := False;
StefanSpawn1 := False;
StefanSpawn2 := False;
StefanSpawn3 := False;
StefanSpawn4 := False;
American_Attack := False;
End_Of_The_Mission := False;

Timer_Start := False;

Timer := [10$0, 9$0, 8$0][Difficulty];
Timer2 := [3$0, 2$30, 2$00][Difficulty];
MaximTime := 2$0;

end;

Export Function DebugMode;
var i;
begin
     if not debug then
     exit;

     Difficulty := 3;
     TurnFogOff();
     FogOff(3);
end;