Export Function InitAction;
Begin

     CenterOnXY(158, 39);
     InGameOn;

     Say(Yakotich, 'DYak-02-01');
     Say(Maxim, 'DMax-02-02');
     Say(Maxim, 'DMax-02-03');
     ChangeMissionObjectives('Ob1');

     RevealFogArea(3, RevealRiverArea);
     InGameOff;

     If LoadVariable('HintyON', 1) then
        AdditionalQuestsQuery(1);


     SaveForQuickRestart;

     repeat
      wait(0$1);
     until See(3, RuDepot) or See(3, RuB1) or See(3, RuB2) or See(3, RuA1);

     InGameOn;

     ComExitVehicle(FilterAllUnits([[f_side, 3]]));

     InGameOn;

     wait(0$1);

     AddComMoveXY(YakotichTeam, 141, 56);
     AddComMoveXY(Yakotich, 131, 48);
     AddComTurnXY(Yakotich, 126, 44);
     AddComMoveXY(Mietek, 126, 46);
     AddComTurnXY(Mietek, 126, 44);
     AddComMoveXY(Smirnovsky, 121, 39);
     AddComMoveXY(Kostyliev, 133, 42);
     AddComMoveXY(Maxim, 136, 49);
     AddComTurnXY(Maxim, 138, 49);


end;

     Every 0$3 Trigger IsInArea(Maxim, MaximTalk) do
     begin

     Say(Maxim, 'DMax-03-01');
     Say(Yakotich, 'DYak-03-02a');
     Say(Maxim, 'DMax-03-02');
     Say(Kostyliev, 'DBog-03-03');
     Say(Smirnovsky, 'DVlad-03-04');
     Say(Yakotich, 'DYak-03-05');
     Say(Yakotich, 'DYak-03-06');
     CenterOnXY(42, 28);
     RevealFogArea(3, RevealNorthArea);
     Say(Maxim, 'DMax-03-07');
     CenterOnXY(63, 83);
     RevealFogArea(3, RevealSouthArea);
     Say(Maxim, 'DMax-03-08');
     CenterOnXY(127, 43);
     Say(Mietek, 'DMietek-03-09');
     Say(Yakotich, 'DYak-03-10');
     ChangeMissionObjectives('Ob1a');
     SetSide([RuDepot, RuB1, RuB2, RuA1], 3);
     InGameOff;

     Wait(0$15);
     BaseCaptured := True;

     Say(Smirnovsky, 'DVlad-04-01');
     Say(Mietek, 'DMietek-04-02');
     Say(Yakotich, 'DYak-04-03');
     ChangeMissionObjectives('Ob2');

     end;

Every 0$1 Trigger BaseCaptured do
begin

     SetRestrict(b_depot, 3, true);

     Wait([10$0,12$0,15$0][Difficulty]);

     DialogueOn;
     InGameOn;
     PlaceUnitArea(Tatiana, TatianaSpawn, True);

     SayRadioNoFace(Tatiana, 'DTat-07-01');
     Say(Yakotich, 'DYak-07-02');
     SayRadioNoFace(Tatiana, 'DTat-07-03');
     Say(Yakotich, 'DYak-07-04b');
     ChangeMissionObjectives('ObTat');
     DialogueOff;
     InGameOff;

     Wait(5$0);

     if not GetSide(Tatiana) = 3 then
     begin
     TatianaMad := True;
     repeat
     ComMoveUnit(Tatiana, Yakotich);
     until See(3, Tatiana);
     CenterOnUnits(Tatiana);
     DialogueOn;
     Say(Tatiana, 'DTat-07-04a');
     Say(Yakotich, 'DYak-07-05a');
     Say(Tatiana, 'DTat-07-06a');
     Say(Tatiana, 'DTat-07-06');
     Say(Yakotich, 'DYak-07-07');
     Say(Tatiana, 'DTat-07-08');
     Say(Tatiana, 'DYak-07-09');
     ChangeMissionObjectives('Ob4');
     CanDismantleGun := True;
     DialogueOff;
     SetSide(Tatiana, 3);
     end;
end;

Every 0$1 Trigger not TatianaMad and See(3, Tatiana) do
begin

     CenterOnUnits(Tatiana);
     DialogueOn;
     Say(Tatiana, 'DTat-07-04');
     Say(Yakotich, 'DYak-07-05');
     Say(Tatiana, 'DTat-07-06');
     Say(Yakotich, 'DYak-07-07');
     Say(Tatiana, 'DTat-07-08');
     Say(Tatiana, 'DYak-07-09');
     ChangeMissionObjectives('Ob4');
     CanDismantleGun := True;
     DialogueOff;
     SetSide(Tatiana, 3);
end;

Every 0$1 Trigger AmericansHeld and FilterAllUnits([[f_or, [f_side, 1], [f_side, 4]], [f_type, unit_human]]) = 0 do
begin

     InGameOn;
     CenterOnUnits(Yakotich);
     Say(Yakotich, 'DYak-10-01');
     SayEX(Kurin, 'DKurin-10-02', 0, 1, 1, 1);
     SayEX(Mike, 'DMike-10-03', 0, 0, 1, 1);
     SayEX(Kurin, 'DKurin-10-04', 0, 1, 1, 1);
     SayEX(Grishko, 'DGrishko-10-05', 0, 1, 1, 1);
     SayEX(Kurin, 'DKurin-10-06', 0, 1, 1, 1);
     Wait(0$2);
     SayEX(Grishko, 'DGrishko-10-07', 0, 1, 1, 1);
     SayEX(Kurin, 'DKurin-10-08', 0, 1, 1, 1);
     SayEX(Grishko, 'DGrishko-10-09', 0, 1, 1, 1);
     SayEX(Kurin, 'DKurin-10-10', 0, 1, 1, 1);
     Say(Yakotich, 'DYak-10-11');
     Wait(0$5);
     SayEX(Kurin, 'DKurin-10-12', 0, 1, 1, 1);
     SayEX(Burlak, 'DBurlak-10-13', 0, 0, 1, 1);
     SayEX(Kurin, 'DKurin-10-14', 0, 1, 1, 1);
     SayEffect('DGunSound-10-15');
     Say(Mietek, 'DMietek-10-16');
     SayEX(Platonov, 'DPlat-10-17', 0, 1, 1, 1);
     Say(Yakotich, 'DYak-10-18');
     SayEX(Platonov, 'DPlat-10-19', 0, 1, 1, 1);
     Say(Yakotich, 'DYak-10-20');
     SayEX(Platonov, 'DPlat-10-21', 0, 1, 1, 1);
     Say(Yakotich, 'DYak-10-22');
     Say(Mietek, 'DMietek-10-23');
     Say(Tatiana, 'DTat-10-24');
     Say(Maxim, 'DMax-10-25');
     Say(Yakotich, 'DYak-10-26');

     EndOfMission := True;
end;


Every 0$1 Trigger EndOfMission do
var unit;
begin

     If GetSide(Tatiana) = 3 and not TatianaMad then
          AddMedal('TatianaMedal', 1)
     else
     begin
         AddMedal('TatianaMedal',-1);
         SaveVariable(TatianaMad, MissionPrefix & 'TatianaMad');
     end;

     If ConvoyEscapedMembers = 0 then
     begin
        AddMedal('AmericansMedal',1);
        for unit in FilterAllUnits([[f_side, 3]]) do
        AddExperience_NoLimit(unit,1,500);
     end
     else if
        ConvoyEscapedMembers <= [5,3,2][Difficulty] then
         AddMedal('AmericansMedal',2)
     else
         AddMedal('ResearchMedal',-1);

     If GunBuilt and CargoBuilt and BunkerBuilt then
        AddMedal('SideQuestsMedal',1)
     else
         AddMedal('SideQuestsMedal',-1);

     GiveMedals('Medals');

     RewardPeople(FilterAllUnits([[f_side, 3], [f_nation, 3], [f_type, unit_human]]));

     SaveCharacters(Yakotich, MissionPrefix & 'Yakotich');
     SaveCharacters(Mietek, MissionPrefix & 'Mietek');
     SaveCharacters(Maxim, MissionPrefix & 'Maxim');
     SaveCharacters(Kostyliev, MissionPrefix & 'Kostyliev');
     SaveCharacters(Smirnovsky, MissionPrefix & 'Smirnovsky');
     SaveCharacters(Tatiana, MissionPrefix & 'Tatiana');

     SaveCharacters(FilterAllUnits([[f_side, 3], [f_nation, 3], [f_type, unit_human]]) diff [Yakotich, Mietek, Maxim, Kostyliev, Smirnovsky, Tatiana], MissionPrefix & 'YakotichTeam');

     YouWin;

end;







