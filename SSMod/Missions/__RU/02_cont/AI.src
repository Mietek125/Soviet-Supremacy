Export southTrackBuilt, southWeaponsResearch;
Every 0$2 trigger AIEnable do
begin
enable;

RepairBuilding(1, AmDep1, AmNorthBaseArea);
RepairBuilding(4, AmDep2, AmSouthBaseArea);
//craneRepair(1, crane, AmNorthBaseArea, craneParkArea);
CraneRepairBuild(1, AmNorthBaseArea, amDestroyedBuildings);
HealUnitInBase(1, AmNorthHealArea, AmNorthBaseArea, AmLab1);

if IsDying(AmDep1) or GetSide(AmDep1) = 3 then
   DefendDepot(1, AmDep1)
else
    EnterBunkerOrBarrack(1, AmNorthBaseArea);

if IsDying(AmDep2) or GetSide(AmDep2) = 3 then
   DefendDepot(4, AmDep2)
else
    EnterBunkerOrBarrack(4, AmSouthBaseArea);
End;

Every 0$1 trigger not IsInUnit(Williams) and IsOk(AmDep1) and GetSide(AmDep1) = 1 do
ComEnterUnit(Williams, AmDep1);

Every 0$1 trigger not IsInUnit(Phillips) and IsOk(AmDep2) and GetSide(AmDep2) = 4 do
ComEnterUnit(Phillips, AmDep2);

Every 0$1 do
begin
ResAllTechs(1, AmLab1, 1);
ResAllTechs(4, AmLab2, 1);
end;

Every 5$0 do
begin
ComUpgradeLab(AmLab2, 10);
ResAllTechs(4, AmLab2, 1);
end;


//SOUTH PRODUCTION


Every 0$1 trigger tick > [12$30, 10$00, 7$00][Difficulty] and FilterAllUnits([[f_side, 4],[f_type, unit_vehicle], [f_driving]]) = 0 and GetSide(AmDep2) = 4 and IsOk(AmDep2) and not AmericansHeld do
begin
enable;

if Difficulty = 1 then
   BuildVehicle(4, AmFactory2, 2, [3, 4], 1, 1, [2, 1][Rand(1, 2)]);

if Difficulty = 2 then
   if southTrackBuilt and southWeaponsResearch then
      BuildVehicle(4, AmFactory2, 2, [5, 3], 1, 1, [4, 3][Rand(1,2)])
   else
       BuildVehicle(4, AmFactory2, 2, [3, 4], 1, 1, [2, 1][Rand(1,2)]);

if Difficulty = 3 then
   if southTrackBuilt and southWeaponsResearch then
      BuildVehicle(4, AmFactory2, 3, 5, 1, 1, 4)
   else
       BuildVehicle(4, AmFactory2, 3, [3, 4], 1, 1, 2);

End;

//NORTH BASE PRODUCTION
Every 0$1 trigger tick > [11$00, 8$00, 5$30][Difficulty] and FilterAllUnits([[f_side, 1], [f_type, unit_vehicle], [f_driving]]) = 0 and GetSide(AmDep1) = 1 and IsOk(AmDep1) and not AmericansHeld do
begin
enable;

if Difficulty = 1 then
   BuildVehicle(1, AmFactory1, 4, [5,4,3], 1, 1, [3,2,4][Rand(1, 3)]);
if Difficulty = 2 then
   BuildVehicle(1, AmFactory1, 5, [5,4,3], 1, 1, [3,2,4][Rand(1, 3)]);
if Difficulty = 3 then
   BuildVehicle(1, AmFactory1, 4, [5,3], 1, 1, [3,2,4][Rand(1, 3)]);


End;


//Convoys
Every 0$1 trigger tick > [6$0, 5$30, 5$0][Difficulty] and not AmericansHeld do
begin

RespawnConvoy(1, 1, [2,3,5][Difficulty], [2,2,3][Difficulty], 2, Rand(UsSoldMinLevel, UsSoldMaxLevel), AmSoldSpawn, EscapeArea);
wait([6$0, 5$30, 5$0][Difficulty]);

enable;

end;



//Attacks

Every 0$1 trigger usMobile do
var i, mech, enemy;
begin
enable;

if not usMobile then
   exit;

for i in usMobile do
    begin
    if not IsOk(i) or getTag(i) = 0 then
    begin
    if GetFuel(i) < 50 then
       begin
       ComMoveXY(i, 33, 23);
       repeat
       wait(0$1);
       until GetDistUnitXY(i, 33, 23) < 4;
       SetFuel(i, 100);
       end
    else if not IsInArea(i, usParking) then
         begin
         ComMoveToArea(i, usParking);
         end
    else
        SetTag(i, 101);
    end;
    if GetTag(i) = 101 then
    begin
    if GetLives(i) < 650 then
       begin
       if not IsDrivenBy(i) then
          continue;

          mech := IsDrivenBy(i);
          ComExitVehicle(mech);
          AddComRepairVehicle(mech, i);

          repeat
          wait(0$1)
          until GetLives(i) = 1000;
          ComEnterUnit(mech, i);
          end
          else if IsDrivenBy(i) then
           SetTag(i, 102);
           end;

           if GetTag(i) = 102 then
           begin
           enemy := FilterUnitsInArea(AmNorthBaseArea, [f_enemy,1]);

           if GetLives(i) < 650 then
              begin
              ComStop(i);
              SetTag(i, 0);
              continue;
              end;
           if enemy then
              begin
              if not HasTask(i) then
                 ComAttackUnit(i, NearestUnitToUnit(enemy, i));
              end
              else if usMobile then
                   begin
                   enemy := FilterAllUnits([f_enemy, 1]);
                   if enemy then
                   AgressiveMove(i, []);
                   end;
                 end;
                end;
 End;

