{
General Info:
Status: 100%
Authors: Mietek & Rahol

Global Vars:
SaveVariable(SafeJarcin, 1); If value = 1 will be in last mission
}

Starting
begin

ResetFog;
Init;

AnimateTrees(true);

Randomize;
RandomizeAll;

PrepareDifficulty;
PrepareAmericanHeroes;
PrepareSouthBase;
PrepareNorthBase;

InitRussian;
InitAction;
InitDeadSoldiers;

SetBName(AmDep1,'mi');
SetBName(AmDep2,'ni');
SetBName(RuDepot,'OutpostG2');

SetAttitude(9,3,1,True);


End;

Export Yakotich, Mietek, Smirnovsky, Kostyliev, Maxim;
Export Tatiana;
Export YakotichTeam, YakotichTeam2;
Export VehicleCount, Tank1, Tank2, Tank3;
Export usMobile;

Export Kurin, Platonov, Grishko, Burlak;
Export KurinTime, ConvoyEscapedMembers;

Export UsSoldMinLevel, UsSoldMaxLevel;
Export AIEnable;
Export amDestroyedBuildings;
Export Williams, Phillips, Mike;

Export Debug;

Export PrevMissionPrefix, MissionPrefix;
Export AmericansHeld, BaseCaptured, TatianaMad, BunkerBuilt, CargoBuilt, GunBuilt, CanDismantleGun, GunDismantled, EndOfMission, AmericansGotAway, FirstContact;

Export Function Init;
begin
//Debug := true; //tests only!

PrevMissionPrefix := '01_';
MissionPrefix := '02_';

VehicleCount := LoadVariable('01_VehiclesCount', 0);
AmericansHeld := False;
BaseCaptured := False;
TatianaMad := False;
BunkerBuilt := False;
CargoBuilt := False;
GunBuilt := False;
CanDismantleGun := False;
GunDismantled := False;
EndOfMission := False;
FirstContact := False;

AmericansGotAway := 0;

UsSoldMinLevel := 3;
UsSoldMaxLevel := 4;

AiEnable = 1;
amDestroyedBuildings = [];
usMobile := [];

KurinTime := 30$0;
end;

Every 0$1 trigger Debug do
var i;
begin

Difficulty := 3;
FogOff(3);

enable;

for i in FilterAllUnits([[f_side, 3], [f_type, unit_human], [f_not, [f_lives, 1000]]]) do
    SetLives(i, 1000);
End;