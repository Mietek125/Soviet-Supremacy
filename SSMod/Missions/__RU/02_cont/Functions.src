end;

end;


Export function InitDeadSoldiers;
var i, un1, un2, un3, un4, hexes1, hexes2, hexes3, hexes4;
begin
hexes1 := AreaToList(AmSoldMeat, 0);
hexes2 := AreaToList(AmMechMeat, 0);
hexes3 := [126, 44];
hexes4 := [138, 49];


for i = 1 to 5 do
    begin
    uc_side := 4;
    uc_nation := 1;

    hc_gallery := '';
    hc_name := '';
    PrepareHuman(rand(1,2), class_soldier, 1);
    un1 := CreateHuman;
    SetDir(un1, 0);
    Create_ColdMeat(un1, hexes1[1][i], hexes1[2][i], true);
    end;

for i = 1 to 2 do
    begin
    PrepareHuman(rand(1,2), class_mechanic, 1);
    un2 := CreateHuman;
    SetDir(un2, 0);
    Create_ColdMeat(un2, hexes2[1][i], hexes2[2][i], true);
    end;

for i = 1 to 1 do
    begin
    uc_side := 9;
    uc_nation := 3;
    PrepareHuman(1, class_soldier, 1);
    un3 := CreateHuman;
    SetDir(un3, 0);
    Create_ColdMeat(un3, 126, 44, true);
    end;

for i = 1 to 2 do
    begin
    PrepareHuman(rand(1,2), class_scientistic, 1);
    un4 := CreateHuman;
    SetDir(un4, 1);
    Create_ColdMeat(un4, 138, 49, true);
    end;

End;


Export function RespawnConvoy(side, nation, soldierCount, vehCount, medCount, skill, spawnArea, targetArea);
var i, j, un, soldiers, vehicles, medics, mechOutOfVeh, mechs, target;
begin
soldiers := [];
medics := [];
vehicles := [];
mechs := [];

for i = 1 to medCount do
    begin
    uc_side := side;
    uc_nation := nation;

    InitHC_All();
    PrepareHuman(false, 4, skill);
    un := CreateHuman;
    medics := Join(medics, un);
    PlaceUnitArea(un, spawnArea, false);
    AddComMoveToArea(un, targetArea);
    end;

for i = 1 to soldierCount do
    begin
    uc_side := side;
    uc_nation := nation;
    InitHC_All();
    PrepareHuman(false, 1, skill);
    un := CreateHuman;
    soldiers := Join(soldiers, un);
    PlaceUnitArea(un, spawnArea, false);
    ComAgressiveMove(un, 87, 58);
    AddComAgressiveMove(un, 127, 63);
    AddComAgressiveMove(un, 159, 98); //  159, 98
    end;

for i = 1 to vehCount do
    begin
    uc_side := side;
    uc_nation := nation;

    vc_chassis := [us_medium_wheeled, us_medium_tracked, us_heavy_tracked][i mod Difficulty + 1];
    vc_engine := engine_combustion;
    vc_control := control_manual;
    vc_weapon := [us_double_gun, us_light_gun, us_gatling_gun, us_machine_gun][i mod Difficulty + 1];

    j := CreateVehicle;
    vehicles := Join(vehicles, j);
    SetDir(j, 1);

    PlaceUnitArea(j, spawnArea, false);

    uc_side := side;
    uc_nation := nation;

    InitHC_All();
    PrepareMechanic(false, 2 + Difficulty);
    un := CreateHuman;
    mechs := Join(mechs, un);
    PlaceHumanInUnit(un, j);
    ComAgressiveMove(j, 87, 58);
    AddComAgressiveMove(j, 127, 63);
    AddComAgressiveMove(j, 127, 40);
    AddComAgressiveMove(un, 159, 98); //  159, 98
    end;

repeat
    for i in soldiers do
    begin
        if IsDead(i) then
        begin
            soldiers := soldiers diff i;
            continue;
        end;

        if IsInArea(i, targetArea) then
        begin
            RemoveUnit(i);
            soldiers := soldiers diff i;
            AmericansGotAway := AmericansGotAway + 1;
            continue;
        end;

        if GetLives(i) < 600 then
        begin
            if GetTag(i) <> 1 then
            begin
                SetTag(i, 1);
                ComMoveToArea(i, targetArea);
            end;
        end;
    end;

    if soldiers then
        wait(0$0.5);

until not soldiers;


repeat
    for i in mechs do
    begin
        if IsDead(i) then
        begin
            mechs := mechs diff i;
            continue;
        end;

        if IsInArea(i, targetArea) then
        begin
            RemoveUnit(i);
            mechs := mechs diff i;
            AmericansGotAway := AmericansGotAway + 1;
            continue;
        end;

        if not IsInUnit(i) then
        begin
            if GetTag(i) <> 1 then
            begin
                SetTag(i, 1);
                ComMoveToArea(i, targetArea);
            end;
        end;
    end;

    if mechs then
        wait(0$0.5);

until not mechs;


repeat
    for i in medics do
    begin
        if IsDead(i) then
        begin
            medics := medics diff i;
            continue;
        end;

        if IsInArea(i, targetArea) then
        begin
            RemoveUnit(i);
            medics := medics diff i;
            AmericansGotAway := AmericansGotAway + 1;
            continue;
        end;
    end;

    if medics then
        wait(0$0.5);

until not medics;
end;

Every 0$1 trigger FilterUnitsInArea(EscapeArea, [[f_or, [f_side, 1], [f_side, 4]]]) do
var i, tmp, tmp2;
begin
ConvoyEscapedMembers := 0;

repeat
 wait(0$1);
 tmp := FilterAllUnits([f_or, [f_side, 1], [f_side, 4]]);
 tmp2 := UnitFilter(tmp, [f_inarea, EscapeArea]);

 for i in tmp2 do
     begin
     RemoveUnit(i);
     ConvoyEscapedMembers := ConvoyEscapedMembers + 1;
     end;
until not tmp;
End;



Every 0$1 Trigger BaseCaptured do
begin
enable;

if KurinTime then
   begin
   KurinTime := KurinTime - 0$1;
   display_strings := ['#KurinTime', KurinTime];
   end
else
   begin
   display_strings := '';
   disable;
   InGameOn;
   DialogueOn;
   SayEX(Kurin, 'DKurin-09-01', 0, 1, 1, 1);
   SayEX(Kurin, 'DKurin-09-02', 0, 1, 1, 1);
   Say(Yakotich, 'DYak-09-03');
   ChangeMissionObjectives('Ob5');
   AmericansHeld := True;
   InGameOff;
   DialogueOff;
   end;
End;


































