On BuildingComplete(building) do
begin

     if GetSide(building) = 3 and GetBType(building) = b_lab_half then
     begin
     Say(Smirnovsky, 'DVlad-05-01');
     Say(Yakotich, 'DYak-05-02');
     ChangeMissionObjectives('Ob3');
     end;
end;

On VehicleConstructed(vehicle, building) Do
begin

     if not GunBuilt and GetWeapon(vehicle) = 44 then
     begin
          InGameOn;
          CenterOnUnits(vehicle);
          Wait(0$3);
          DialogueOn;
          Say(Tatiana, 'DTat-08-01');
          Say(Yakotich, 'DYak-08-02');
          ChangeMissionObjectives('Ob4a');
          GunBuilt := True;
          DialogueOff;
          InGameOff;
     end;

     if GetWeapon(vehicle) = 51 or GetWeapon(vehicle) = 90 then
     begin
     CargoBuilt := True;
     ChangeMissionObjectives('Ob2a');
     end;


     if GetSide(vehicle) = 1 or GetSide(vehicle) = 4 then
        usMobile := usMobile union vehicle;

end;

Every 0$1 Trigger FilterAllUnits([[f_side, 3], [f_type, unit_building], [f_btype, b_bunker]]) >= 3 do
begin
     ChangeMissionObjectives('Ob2b');
     BunkerBuilt := True;
end;

On VehicleRecycled(BuildingID, VehicleID, Side, Nation, X,Y, Direction, Chassis, Controller, Engine, Weapon) do
begin
if Side = 3 and Nation = 1 and Weapon in [3,5,6] and GunDismantled = false and GetSide(Tatiana) = 3 then
begin

GunDismantled := True;
SetTech(39,3,1);
SetRestrict(17,3,1);

end;

end;

On Contact(side1,side2) do
var i;
begin
    if (side1 = 4 and side2 = 3) or (side1 = 1 and side2 = 3) and not FirstContact then
    begin
        for i in side1 do
        begin
        CenterOnUnits(i);
        Say(Yakotich, 'DYak-06-01');
        FirstContact := True;
        end;
    end;
end;


On EvacuateVehicle(driver, veh, p1, p2) do
begin

     if GetSide(veh) = 1 and driver in usMobile then
        ComEnterUnit(driver, AmFactory1);
     if GetSide(veh) = 4 and driver in usMobile then
        ComEnterUnit(driver, AmFactory2);
end;

On EnterBuilding(b, un) do
begin
     if b = AmFactory1 or AmFactory2 and GetLives(un) < 1000 then
        SetLives(un, 1000);
End;

Every 0$1 Trigger IsDead(RuDepot) do
YouLost('DepotDead');

On UnitDestroyed(un) do
begin
     if un in FilterAllUnits([[f_side, 3], [f_not, [f_nation, 0]], [f_type, unit_human]]) diff [Yakotich, Mietek] then
     Begin
     YouLost('TeamDead');
     end;

     if un = Yakotich then
     YouLost('YakDead');

     if un = Mietek then
     YouLost('MietekDead');

end;

Every 0$1 Trigger GetSide(Tatiana) = 3 do
CanDismantleGun = True;



Every 0$1 Trigger ConvoyEscapedMembers >= [10,7,5][Difficulty] do
YouLost('AmericansGotAway');